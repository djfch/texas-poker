# Environment Configuration for Texas Hold'em Poker
# Copy this file to .env and fill in your values.

# ─── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Static frontend directory served by Express (relative to CWD).
# Defaults to the Vue build output; run `npm run build:app` first, or use
# the Vite dev server (`npm run dev:app`) during development.
FRONTEND_DIR=frontend-app/dist

# ─── AI Provider (OpenAI-compatible) ─────────────────────────────
# Examples: OpenAI, DeepSeek, Moonshot, Qwen, Groq, Anyscale, etc.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-4o-mini

# AI behavior tuning
AI_TIMEOUT_MS=10000
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=4096
AI_FALLBACK_ENABLED=true

# ─── Security ────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins; leave empty to allow all (dev only)
CORS_ORIGINS=

# JWT signing secret. Dev has an insecure built-in fallback;
# production MUST set an explicit strong secret.
JWT_SECRET=
# Token lifetime (jsonwebtoken format, e.g. 7d, 12h, 3600)
JWT_EXPIRES_IN=7d

# ─── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100


# ─── Storage Backend ─────────────────────────────────────────────
# Which Storage implementation to use: memory (default, no external
# services), postgres (users + hand history in PostgreSQL), redis
# (players/rooms/games runtime state in Redis).
STORE_BACKEND=memory

# PostgreSQL connection (required when STORE_BACKEND=postgres)
DATABASE_URL=postgres://poker:poker@localhost:5432/poker

# Redis connection (required when STORE_BACKEND=redis). Setting REDIS_URL
# also switches the server to multi-instance mode (Socket.IO redis-adapter
# + room-level scheduler ownership) and therefore REQUIRES
# STORE_BACKEND=redis — any other combination fails fast at startup.
REDIS_URL=redis://localhost:6379

# ─── Docker Compose only ──────────────────────────────────
# Consumed by docker-compose.yml variable substitution, not by the app
# process itself (POSTGRES_* is also interpolated into DATABASE_URL there).
NGINX_PORT=80
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker
POSTGRES_DB=poker
# Host-side debug ports for postgres/redis (localhost-bound). Change these
# if another service on the host already occupies 5432/6379 — the app
# itself connects over the internal Docker network and is unaffected.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
